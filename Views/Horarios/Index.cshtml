@model HorariosViewModel
@{
    ViewData["Title"] = "Horários";
    var nomesDia = new[] { "Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira", "Sábado" };
    var erroSemana = ViewBag.ErroSemana as string;
}

@functions {
    string Descrever(BloqueioAgenda b)
    {
        var ultimoMinuto = b.Fim.AddMinutes(-1);   // o Fim é exclusivo
        var diaInteiro = b.Inicio.TimeOfDay == TimeSpan.Zero && b.Fim.TimeOfDay == TimeSpan.Zero;

        if (diaInteiro)
        {
            return b.Inicio.Date == ultimoMinuto.Date
                ? b.Inicio.ToString("dd/MM/yyyy")
                : $"{b.Inicio:dd/MM/yyyy} a {ultimoMinuto:dd/MM/yyyy}";
        }

        return $"{b.Inicio:dd/MM/yyyy} · {b.Inicio:HH'h'mm} às {b.Fim:HH'h'mm}";
    }
}

<div class="page-intro">
    <h1>Horários</h1>
    <p>Defina quando você atende e as regras da agenda. É a base do agendamento online das clientes.</p>
    <hr />
</div>

<div class="form-card form-card-wide">
    <h2 class="card-title">Horário de atendimento</h2>

    @if (!Model.HorariosSalvos)
    {
        <p class="form-hint">Ainda não foi salvo: estes são horários sugeridos. Ajuste e clique em salvar.</p>
    }
    @if (!string.IsNullOrEmpty(erroSemana))
    {
        <div class="conflict-box">@erroSemana</div>
    }

    <form asp-action="SalvarSemana" method="post">
        <div class="week-list">
            @for (int i = 0; i < Model.Dias.Count; i++)
            {
                var d = Model.Dias[i];
                <div class="week-row @(d.Ativo ? "" : "off")">
                    <input type="hidden" name="Dias[@i].DiaSemana" value="@d.DiaSemana" />
                    <label class="toggle-row week-day">
                        <input type="checkbox" name="Dias[@i].Ativo" value="true" class="toggle-input week-toggle" checked="@d.Ativo" />
                        <span class="toggle-track"><span class="toggle-thumb"></span></span>
                        @nomesDia[d.DiaSemana]
                    </label>
                    <div class="week-periods">
                        <input type="time" name="Dias[@i].Inicio1" value="@d.Inicio1" class="input-pill time-pill" />
                        <span>às</span>
                        <input type="time" name="Dias[@i].Fim1" value="@d.Fim1" class="input-pill time-pill" />
                        <span class="week-sep">e</span>
                        <input type="time" name="Dias[@i].Inicio2" value="@d.Inicio2" class="input-pill time-pill" />
                        <span>às</span>
                        <input type="time" name="Dias[@i].Fim2" value="@d.Fim2" class="input-pill time-pill" />
                    </div>
                </div>
            }
        </div>
        <p class="field-note">O segundo período é opcional: use para a pausa de almoço (ex.: 09:00 às 12:00 e 14:00 às 18:00).</p>

        <div class="form-actions">
            <button type="submit" class="btn-pill">Salvar horários</button>
        </div>
    </form>
</div>

<div class="form-card form-card-wide">
    <h2 class="card-title">Regras da agenda</h2>

    <form asp-action="SalvarRegras" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="section-label" style="margin-top:0;">Atalhos de duração dos serviços</div>
        <div class="field-row-3">
            <div class="field-group">
                <label asp-for="Config.PresetRapidoMin" class="field-label"></label>
                <input asp-for="Config.PresetRapidoMin" type="number" min="5" max="600" step="5" inputmode="numeric" class="input-pill" />
                <span asp-validation-for="Config.PresetRapidoMin" class="text-danger"></span>
            </div>
            <div class="field-group">
                <label asp-for="Config.PresetMedioMin" class="field-label"></label>
                <input asp-for="Config.PresetMedioMin" type="number" min="5" max="600" step="5" inputmode="numeric" class="input-pill" />
                <span asp-validation-for="Config.PresetMedioMin" class="text-danger"></span>
            </div>
            <div class="field-group">
                <label asp-for="Config.PresetDemoradoMin" class="field-label"></label>
                <input asp-for="Config.PresetDemoradoMin" type="number" min="5" max="600" step="5" inputmode="numeric" class="input-pill" />
                <span asp-validation-for="Config.PresetDemoradoMin" class="text-danger"></span>
            </div>
        </div>
        <p class="field-note" style="margin-top:-6px; margin-bottom:18px;">Aparecem como botões ao cadastrar um serviço. Mudar aqui não altera os serviços que já existem.</p>

        <div class="section-label">Agendamento online</div>
        <div class="field-row">
            <div class="field-group">
                <label asp-for="Config.IntervaloMin" class="field-label"></label>
                <input asp-for="Config.IntervaloMin" type="number" min="0" max="120" step="5" inputmode="numeric" class="input-pill" />
                <span asp-validation-for="Config.IntervaloMin" class="text-danger"></span>
            </div>
            <div class="field-group">
                <label asp-for="Config.AntecedenciaHoras" class="field-label"></label>
                <input asp-for="Config.AntecedenciaHoras" type="number" min="0" max="72" inputmode="numeric" class="input-pill" />
                <span asp-validation-for="Config.AntecedenciaHoras" class="text-danger"></span>
            </div>
        </div>
        <div class="field-row">
            <div class="field-group">
                <label asp-for="Config.DiasAFrente" class="field-label"></label>
                <input asp-for="Config.DiasAFrente" type="number" min="1" max="365" inputmode="numeric" class="input-pill" />
                <span asp-validation-for="Config.DiasAFrente" class="text-danger"></span>
            </div>
            <div class="field-group">
                <label asp-for="Config.PassoMin" class="field-label"></label>
                <input asp-for="Config.PassoMin" type="number" min="5" max="120" step="5" inputmode="numeric" class="input-pill" />
                <span asp-validation-for="Config.PassoMin" class="text-danger"></span>
            </div>
        </div>
        <div class="field-group">
            <label asp-for="Config.WhatsApp" class="field-label"></label>
            <input asp-for="Config.WhatsApp" type="tel" inputmode="tel" class="input-pill" placeholder="(11) 90000-0000" />
            <span asp-validation-for="Config.WhatsApp" class="text-danger"></span>
        </div>
        <p class="field-note" style="margin-top:-6px;">O intervalo é o tempo livre depois de cada atendimento (limpeza, descanso). O WhatsApp aparece na página pública para a cliente falar com você.</p>

        <div class="form-actions" style="margin-top:20px;">
            <button type="submit" class="btn-pill">Salvar regras</button>
        </div>
    </form>
</div>

<div class="form-card form-card-wide">
    <h2 class="card-title">Bloqueios (folgas, feriados, férias)</h2>

    <form asp-action="AdicionarBloqueio" method="post">
        <div class="field-row">
            <div class="field-group">
                <label class="field-label">Data inicial</label>
                <input type="date" name="dataInicio" class="input-pill" required />
            </div>
            <div class="field-group">
                <label class="field-label">Data final (opcional)</label>
                <input type="date" name="dataFim" class="input-pill" />
            </div>
        </div>
        <div class="field-row">
            <div class="field-group">
                <label class="field-label">Das (opcional)</label>
                <input type="time" name="horaInicio" class="input-pill" />
            </div>
            <div class="field-group">
                <label class="field-label">Às (opcional)</label>
                <input type="time" name="horaFim" class="input-pill" />
            </div>
        </div>
        <div class="field-group">
            <label class="field-label">Motivo (opcional)</label>
            <input type="text" name="motivo" maxlength="120" class="input-pill" placeholder="Ex.: feriado, consulta, curso" />
        </div>
        <p class="field-note" style="margin-top:-6px; margin-bottom:16px;">Sem horário, bloqueia os dias inteiros. Com horário, bloqueia só aquela faixa, no dia da data inicial.</p>
        <div class="form-actions">
            <button type="submit" class="btn-pill">Adicionar bloqueio</button>
        </div>
    </form>

    @if (Model.Bloqueios.Any())
    {
        <div class="section-label">Próximos bloqueios</div>
        @foreach (var b in Model.Bloqueios)
        {
            <div class="block-item">
                <div>
                    <strong>@Descrever(b)</strong>
                    @if (!string.IsNullOrWhiteSpace(b.Motivo))
                    {
                        <span>@b.Motivo</span>
                    }
                </div>
                <form asp-action="RemoverBloqueio" method="post" onsubmit="return confirm('Remover este bloqueio?');">
                    <input type="hidden" name="id" value="@b.Id" />
                    <button type="submit" class="icon-btn danger" title="Remover">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </form>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.week-toggle').forEach(function (cb) {
            cb.addEventListener('change', function () {
                cb.closest('.week-row').classList.toggle('off', !cb.checked);
            });
        });
    </script>
}

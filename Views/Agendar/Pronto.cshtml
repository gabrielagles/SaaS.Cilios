@inject SaaS.Cilios.Data.AppDbContext Db
@model Agendamento
@{
    ViewData["Title"] = "Agendamento confirmado";
    ViewData["NoIndex"] = true;
    var cfg = Db.ConfiguracoesAgenda.FirstOrDefault();
    var horas = cfg?.CancelamentoHoras ?? 12;
    var linkCancelar = Url.Action("Cancelar", "Agendar", new { codigo = Model.CodigoPublico }, Context.Request.Scheme);
    var mensagem = $"Olá! Acabei de agendar {Model.Servico?.Nome} para {Model.DataHora:dd/MM} às {Model.DataHora:HH'h'mm}. Meu nome é {Model.ClienteNome}.";
    var whatsapp = WhatsAppHelper.Link(cfg?.WhatsApp, mensagem);
}

<div class="done-card">
    <div class="done-icon">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <h2>Horário confirmado!</h2>
    <p class="done-when">@Model.DataHora.ToString("dddd, dd 'de' MMMM") às @Model.DataHora.ToString("HH:mm")</p>
    <p class="done-what">@Model.Servico?.Nome · @DuracaoHelper.Texto(Model.DuracaoMinutos) · R$ @Model.Valor.ToString("N2")</p>
    <p class="done-who">em nome de @Model.ClienteNome</p>
</div>

<div class="form-actions" style="margin-top:18px;">
    @if (whatsapp != null)
    {
        <a href="@whatsapp" target="_blank" rel="noopener" class="btn-pill" style="text-align:center; text-decoration:none;">Avisar no WhatsApp</a>
    }
    <a asp-action="Index" class="btn-pill-ghost">Fazer outro agendamento</a>
</div>

<div class="done-note">
    <strong>Precisa cancelar?</strong> Guarde este link. Você pode cancelar sozinha até @horas hora@(horas == 1 ? "" : "s") antes do horário:
    <a href="@linkCancelar">@linkCancelar</a>
</div>

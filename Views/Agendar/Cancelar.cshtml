@inject SaaS.Cilios.Data.AppDbContext Db
@model Agendamento
@{
    ViewData["Title"] = "Cancelar horário";
    ViewData["NoIndex"] = true;
    var cfg = Db.ConfiguracoesAgenda.FirstOrDefault();
    var horas = cfg?.CancelamentoHoras ?? 12;
    var cancelado = Model.Status == StatusAgendamento.Cancelado;
    var jaPassou = Model.DataHora <= DateTime.Now;
    var tarde = !jaPassou && (Model.DataHora - DateTime.Now) < TimeSpan.FromHours(horas);
    var whatsapp = WhatsAppHelper.Link(cfg?.WhatsApp,
        $"Olá! Preciso falar sobre o meu horário de {Model.Servico?.Nome} em {Model.DataHora:dd/MM} às {Model.DataHora:HH'h'mm}. Meu nome é {Model.ClienteNome}.");
}

<div class="done-card">
    <h2>@Model.Servico?.Nome</h2>
    <p class="done-when">@Model.DataHora.ToString("dddd, dd 'de' MMMM") às @Model.DataHora.ToString("HH:mm")</p>
    <p class="done-who">em nome de @Model.ClienteNome</p>
</div>

@if (cancelado)
{
    <div class="done-note"><strong>Esse horário está cancelado.</strong> Se quiser, é só marcar outro.</div>
    <div class="form-actions" style="margin-top:16px;">
        <a asp-action="Index" class="btn-pill" style="text-align:center; text-decoration:none;">Agendar de novo</a>
    </div>
}
else if (jaPassou)
{
    <div class="done-note">Esse horário já passou.</div>
}
else if (tarde)
{
    <div class="done-note">
        <strong>Já não dá mais para cancelar por aqui</strong>, porque faltam menos de @horas hora@(horas == 1 ? "" : "s") para o horário. Fale com a gente pelo WhatsApp.
    </div>
    @if (whatsapp != null)
    {
        <div class="form-actions" style="margin-top:16px;">
            <a href="@whatsapp" target="_blank" rel="noopener" class="btn-pill" style="text-align:center; text-decoration:none;">Falar no WhatsApp</a>
        </div>
    }
}
else
{
    <div class="done-note">Você pode cancelar sozinha até @horas hora@(horas == 1 ? "" : "s") antes do horário. O horário volta a ficar livre para outras clientes.</div>
    <form asp-action="CancelarPost" asp-route-codigo="@Model.CodigoPublico" method="post" class="form-actions" style="margin-top:16px;"
          onsubmit="return confirm('Cancelar este horário?');">
        <button type="submit" class="btn-pill-danger">Cancelar meu horário</button>
        <a asp-action="Index" class="btn-pill-ghost">Voltar</a>
    </form>
}

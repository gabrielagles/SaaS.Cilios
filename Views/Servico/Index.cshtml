@model List<Servico>
@{ ViewData["Title"] = "Serviços"; }

<div class="list-header">
    <h1>Serviços</h1>
    <a asp-action="Create" class="btn btn-primary">+ Novo Serviço</a>
</div>

@if (!Model.Any())
{
    <div class="table-empty">
        <span class="script">Nada por aqui ainda</span>
        <p>Cadastre o primeiro serviço pra começar a montar a agenda.</p>
    </div>
}
else
{
    <div class="table-card">
        <table class="table">
            <thead>
                <tr><th>Cor</th><th>Nome</th><th>Preço</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><span class="d-inline-block rounded-circle" style="width:20px;height:20px;background-color:@s.Cor;"></span></td>
                        <td>@s.Nome</td>
                        <td>R$ @s.Preco.ToString("N2")</td>
                        <td>@(s.Ativo ? "Ativo" : "Inativo")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.Id" class="icon-btn" title="Editar">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                            <a asp-action="Delete" asp-route-id="@s.Id" class="icon-btn danger" title="Excluir">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
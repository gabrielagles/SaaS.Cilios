@model Servico
@{ ViewData["Title"] = "Novo Serviço"; }

<div class="form-card">
    <h1>Novo Serviço</h1>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="field-group">
            <label asp-for="Nome" class="field-label"></label>
            <input asp-for="Nome" class="input-pill" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="field-group">
            <label asp-for="Cor" class="field-label"></label>
            <input asp-for="Cor" type="color" class="form-control form-control-color" />
        </div>

        <div class="field-group">
            <label asp-for="Preco" class="field-label"></label>
            <input type="text" inputmode="numeric" id="PrecoVisivel" class="input-pill" placeholder="0,00" autocomplete="off" />
            <input type="hidden" asp-for="Preco" id="Preco" />
            <span asp-validation-for="Preco" class="text-danger"></span>
        </div>

        <div class="field-group">
            <label asp-for="DuracaoMinutos" class="field-label"></label>
            <div class="chip-row">
                <button type="button" class="chip" data-min="30">Rápido · 30 min</button>
                <button type="button" class="chip" data-min="60">Médio · 1h</button>
                <button type="button" class="chip" data-min="120">Demorado · 2h</button>
            </div>
            <input asp-for="DuracaoMinutos" id="DuracaoMinutos" type="number" min="5" max="600" step="5" inputmode="numeric" class="input-pill" />
            <span asp-validation-for="DuracaoMinutos" class="text-danger"></span>
        </div>

        <label class="toggle-row">
            <input asp-for="Ativo" class="toggle-input" checked />
            <span class="toggle-track"><span class="toggle-thumb"></span></span>
            Serviço ativo
        </label>

        <div class="form-actions">
            <button type="submit" class="btn-pill">Salvar</button>
            <a asp-action="Index" class="btn-pill-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // ---- preço (máscara de dinheiro) ----
        var visivel = document.getElementById('PrecoVisivel');
        var oculto = document.getElementById('Preco');

        function paraNumero(txt) {
            var s = String(txt || '0').trim();
            if (s.indexOf(',') > -1) { s = s.replace(/\./g, '').replace(',', '.'); }
            return parseFloat(s) || 0;
        }
        function formatar(centavos) {
            return (centavos / 100).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function atualizar() {
            var digitos = visivel.value.replace(/\D/g, '');
            if (digitos === '') digitos = '0';
            var centavos = parseInt(digitos, 10);
            visivel.value = formatar(centavos);
            oculto.value = (centavos / 100).toFixed(2).replace('.', ',');
        }
        visivel.value = formatar(Math.round(paraNumero(oculto.value) * 100));
        visivel.addEventListener('input', atualizar);

        // ---- duração (atalhos rápido / médio / demorado) ----
        var duracao = document.getElementById('DuracaoMinutos');
        var chips = document.querySelectorAll('.chip');
        function marcarChip() {
            var atual = String(parseInt(duracao.value, 10));
            chips.forEach(function (c) {
                c.classList.toggle('active', c.getAttribute('data-min') === atual);
            });
        }
        chips.forEach(function (c) {
            c.addEventListener('click', function () {
                duracao.value = c.getAttribute('data-min');
                marcarChip();
            });
        });
        duracao.addEventListener('input', marcarChip);
        marcarChip();
    </script>
}

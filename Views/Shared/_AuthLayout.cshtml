<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Rafaela Lavieri Beauty Studio</title>

    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#8A4E63" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cílios Agenda" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="icon" href="~/icons/icon-192.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Alex+Brush&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/beauty-theme.css" />
</head>
<body>
    <div class="beauty-shell">
        <div id="offlineBanner" class="offline-banner"></div>
        @RenderBody()
    </div>
    <script src="~/js/pwa-register.js"></script>
    <script src="~/js/offline-sync.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@inject SaaS.Cilios.Data.AppDbContext Db
@{
    var configPainel = Db.ConfiguracoesConta.FirstOrDefault();
    var nomePainel = configPainel?.NomePainel ?? "Cílios Agenda";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - @nomePainel</title>

    <!-- PWA / iPhone -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#8A4E63" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cílios Agenda" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="icon" href="~/icons/icon-192.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Alex+Brush&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/beauty-theme.css" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/coroa.png" alt="" class="navbar-crown" />
                @nomePainel
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu" aria-controls="navbarMenu" aria-expanded="false" aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">
                <div class="navbar-nav ms-md-auto">
                    <a class="nav-link" asp-controller="Agendamento" asp-action="Index">Agendamentos</a>
                    <a class="nav-link" asp-controller="Agendamento" asp-action="Calendario">Agenda</a>
                    <a class="nav-link" asp-controller="Servico" asp-action="Index">Serviços</a>
                    <a class="nav-link" asp-controller="Agendamento" asp-action="Relatorio">Balanço Mensal</a>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a class="nav-link" asp-controller="Conta" asp-action="Index">Conta</a>
                        <a class="nav-link" asp-controller="Account" asp-action="Logout">Sair</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <div id="offlineBanner" class="offline-banner"></div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Sucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- <script src="~/js/pwa-register.js"></script> -->
    <script src="~/js/offline-sync.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
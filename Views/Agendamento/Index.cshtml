@model List<Agendamento>
@{ ViewData["Title"] = "Agendamentos"; }

<div class="list-header">
    <h1>Agendamentos</h1>
    <a asp-action="Create" class="btn btn-primary">+ Novo Agendamento</a>
</div>

@if (!Model.Any())
{
    <div class="table-empty">
        <span class="script">Nada por aqui ainda</span>
        <p>Assim que você criar um agendamento, ele aparece nesta lista.</p>
    </div>
}
else
{
    <div class="table-card">
        <table class="table">
            <thead>
                <tr><th>Data/Hora</th><th>Cliente</th><th>Serviço</th><th>Valor</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var ag in Model)
                {
                    <tr>
                        <td>@ag.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@ag.ClienteNome</td>
                        <td><span class="badge" style="background-color:@ag.Servico?.Cor">@ag.Servico?.Nome</span></td>
                        <td>R$ @ag.Valor.ToString("N2")</td>
                        <td>
                            @if (ag.Concluido)
                            {
                                <span class="badge text-bg-success">Concluído</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Pendente</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@ag.Id" class="icon-btn" title="Editar">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                            <a asp-action="Delete" asp-route-id="@ag.Id" class="icon-btn danger" title="Excluir">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
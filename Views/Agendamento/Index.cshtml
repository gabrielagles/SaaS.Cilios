@model List<Agendamento>
@{
    ViewData["Title"] = "Agendamentos";
    var mostrarCancelados = ViewBag.MostrarCancelados is bool mc && mc;
}

<div class="list-header">
    <h1>Agendamentos</h1>
    <a asp-action="Create" class="btn btn-primary">+ Novo Agendamento</a>
</div>

<p class="filter-link">
    @if (mostrarCancelados)
    {
        <a asp-action="Index">Ocultar cancelados</a>
    }
    else
    {
        <a asp-action="Index" asp-route-cancelados="true">Mostrar cancelados</a>
    }
</p>

@if (!Model.Any())
{
    <div class="table-empty">
        <span class="script">Nada por aqui ainda</span>
        <p>Assim que você criar um agendamento, ele aparece nesta lista.</p>
    </div>
}
else
{
    <div class="table-card">
        <table class="table">
            <thead>
                <tr><th>Data/Hora</th><th>Cliente</th><th>Serviço</th><th>Valor</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var ag in Model)
                {
                    <tr class="@(ag.Status == StatusAgendamento.Cancelado ? "row-cancelled" : "")">
                        <td>@ag.DataHora.ToString("dd/MM/yyyy HH:mm") <span class="text-muted">– @ag.Fim.ToString("HH:mm")</span></td>
                        <td>@ag.ClienteNome @if (ag.Origem == OrigemAgendamento.Online) { <span class="online-tag">online</span> }</td>
                        <td><span class="badge" style="background-color:@ag.Servico?.Cor">@ag.Servico?.Nome</span></td>
                        <td>R$ @ag.Valor.ToString("N2")</td>
                        <td>
                            @if (ag.Status == StatusAgendamento.Cancelado)
                            {
                                <span class="badge text-bg-secondary">Cancelado</span>
                            }
                            else if (ag.Concluido)
                            {
                                <span class="badge text-bg-success">Concluído</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Pendente</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@ag.Id" class="icon-btn" title="Editar">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
@if (ag.Status == StatusAgendamento.Cancelado)
                            {
                                <form asp-action="Reativar" asp-route-id="@ag.Id" method="post" class="d-inline">
                                    <button type="submit" class="icon-btn" title="Reativar"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 3-6.7M3 4v5h5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Cancelar" asp-route-id="@ag.Id" method="post" class="d-inline" onsubmit="return confirm('Cancelar este agendamento? O horário ficará livre.');">
                                    <button type="submit" class="icon-btn" title="Cancelar"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                                </form>
                            }
                            <a asp-action="Delete" asp-route-id="@ag.Id" class="icon-btn danger" title="Excluir">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6h16z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}